DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CHANNEL_ID=your_discord_channel_id_here

# NTU 台大帳號
NTU_USERNAME=your_ntu_student_id
NTU_PASSWORD=your_ntu_password
WEBMAIL_USERNAME=your_ntu_student_id
WEBMAIL_PASSWORD=your_ntu_password

# Gmail
GMAIL_EMAIL=your_gmail@gmail.com

# API Server 安全金鑰（用 python3 -c "import secrets; print(secrets.token_hex(32))" 產生）
API_SECRET_KEY=your_random_api_secret_key_here

# Foursquare Places API（用於「幫我決定吃什麼」功能，免費不需信用卡）
# 申請：https://foursquare.com/developers/signup → 建立 App → 複製 API Key
FOURSQUARE_API_KEY=your_foursquare_api_key_here

# LocalTunnel 子網域前綴（請選一個獨特的名字，系統會自動生成 v1~v5 備援）
# 例如：john-nemo-api → 會使用 john-nemo-api-v1.loca.lt ~ john-nemo-api-v5.loca.lt
TUNNEL_SUBDOMAIN_PREFIX=your-unique-prefix-here
